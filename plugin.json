{
    "id": "com.devlopali.gamification",
    "name": "Gamification",
    "description": "Compte les messages des utilisateurs (par channel et global) et affiche un leaderboard dans un panneau latéral.",
    "homepage_url": "https://github.com/Devlopali-dev/mattermost-gamification",
    "support_url": "https://github.com/Devlopali-dev/mattermost-gamification/issues",
    "icon_path": "assets/starter-template-icon.svg",
    "version": "0.1.0",
    "min_server_version": "9.0.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "Paramètres du système de gamification.",
        "footer": "",
        "settings": [
            {
                "key": "ExcludedChannels",
                "display_name": "Channels exclus",
                "type": "text",
                "help_text": "IDs de channels à exclure du comptage, séparés par des virgules.",
                "default": ""
            },
            {
                "key": "LeaderboardSize",
                "display_name": "Taille du classement",
                "type": "number",
                "help_text": "Nombre d'utilisateurs affichés dans le leaderboard.",
                "default": 10
            }
        ]
    }
}